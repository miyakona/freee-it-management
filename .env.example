## freee IT管理 GraphQL CLI env
## 使い方:
##   cp .env.example .env
##   # .env を埋める

# 必須: GraphQL endpoint
FREEE_IT_GRAPHQL_ENDPOINT=https://YOUR-ENDPOINT/graphql

# 必須: Bearer token（例: "xxxxx"）
FREEE_IT_TOKEN=YOUR_TOKEN

# 任意: enum 検証に使う schema.json のパス（デフォルト: ./schema.json）
FREEE_IT_SCHEMA_PATH=./schema.json

# 任意: HTTP timeout(ms)（デフォルト: 30000）
FREEE_IT_HTTP_TIMEOUT_MS=30000

